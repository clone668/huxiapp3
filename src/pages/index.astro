---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works'))
  .filter((w) => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="首页">
  <!-- hero -->
  <section class="hero">
    <div class="lead">
      <h2>做的东西不多，<br />但每一件都<em>还在用</em>。</h2>
      <p>写的字更少，但每一句都是真的。这里是我做的东西，和偶尔写的一点字。</p>
    </div>
    <aside class="side">
      <h4>✦ By The Numbers</h4>
      <div class="fact">6 件作品<span>信号站 / 建模 / AI 工具 / 扩展 / 小程序 / 鲁班尺</span></div>
      <div class="fact">2 篇文章<span>刚刚开张，持续更新</span></div>
      <div class="fact">2 个域名<span>huxi.app · coinsig.io</span></div>
    </aside>
  </section>

  <!-- 精选作品 -->
  <section class="works">
    <div class="sec-label">
      <h3>作品</h3>
      <div class="meta">
        <span class="no">Fig. 1–{works.length}</span>
        <a class="more" href="/works">More →</a>
      </div>
    </div>
    <div class="work-grid">
      {works.map((w, i) => (
        <a class="work-cell" href={`/works/${w.id}`}>
          <div class="fig">Fig. {i + 1}</div>
          <h5>{w.data.title}</h5>
          <p>{w.data.description}</p>
          <div class="foot">{w.data.stack.join(' · ')} · {w.data.year}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="writing">
    <div class="sec-label">
      <h3>文章</h3>
      <div class="meta">
        <span class="no">Selected</span>
        <a class="more" href="/blog">More →</a>
      </div>
    </div>
    <div class="post-list">
      {posts.map((p) => (
        <a class="post" href={`/blog/${p.id}`}>
          <div class="kicker">{p.data.kicker}</div>
          <h6>{p.data.title}</h6>
          <p class="excerpt">{p.data.description}</p>
          <span class="date">{fmtDate(p.data.date)}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
