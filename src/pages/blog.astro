---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="文章">
  <section class="writing">
    <div class="sec-label">
      <h3>Writing</h3>
      <div class="meta">
        <span class="no">{posts.length} Pieces</span>
      </div>
    </div>
    <div class="post-list single">
      {posts.map((p) => (
        <a class="post" href={`/blog/${p.id}`}>
          <div class="kicker">{p.data.kicker}</div>
          <h6>{p.data.title}</h6>
          <p class="excerpt">{p.data.description}</p>
          <span class="date">{fmtDate(p.data.date)}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
