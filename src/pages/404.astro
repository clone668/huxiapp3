---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <div class="not-found">
    <p class="en">This page doesn't exist, or has been moved.</p>
    <svg class="code-svg" viewBox="0 0 400 125" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="404">
      <text class="code-text" x="200" y="105" text-anchor="middle" fill="none" stroke="currentColor" stroke-width="1.6">404</text>
    </svg>
    <a href="/">回到首页</a>
  </div>
</Base>

<style>
  .not-found {
    text-align: center;
    padding: 60px 0 60px;
  }
  .not-found .en {
    margin: 0 0 32px;
    color: var(--dim);
    font-size: .85rem;
    letter-spacing: .05em;
  }
  .code-svg {
    width: min(360px, 70vw);
    display: block;
    margin: 0 auto 32px;
  }
  .code-text {
    font-family: 'Noto Sans SC', sans-serif;
    font-weight: 700;
    font-size: 110px;
    letter-spacing: .08em;
    color: var(--ink);
    transform: scaleY(.82);
    transform-origin: 200px 105px;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: code-draw 2.4s .2s forwards;
  }
  @keyframes code-draw {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .code-text { animation: none; stroke-dashoffset: 0; }
  }
  .not-found a {
    font-family: 'JetBrains Mono', monospace;
    font-size: .8rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color .2s, border-color .2s;
  }
  .not-found a:hover {
    color: var(--accent-hover);
    border-bottom-color: var(--accent-hover);
  }
</style>
