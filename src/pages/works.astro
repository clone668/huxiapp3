---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works'))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="作品">
  <section class="works">
    <div class="sec-label">
      <h3>Works</h3>
      <div class="meta">
        <span class="no">#01–#{String(works.length).padStart(2, '0')}</span>
      </div>
    </div>
    <div class="work-list">
      {works.map((w, i) => (
        <a class="work-row" href={`/works/${w.id}`}>
          <span class="row-fig">#{String(i + 1).padStart(2, '0')}</span>
          <span class="row-main">
            <h5>{w.data.title}</h5>
            <p>{w.data.description}</p>
          </span>
          <span class="row-foot">{w.data.stack.join(' · ')} · {w.data.year}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
